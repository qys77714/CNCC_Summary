# 相对路径均相对于本 .env 所在目录。复制到服务器后无需修改项目绝对路径。
INPUT_DIR=./video
OUTPUT_DIR=./output
# 同一台主机的 GPU 可见编号，支持单卡 0；外部设置 CUDA_VISIBLE_DEVICES 时填可见逻辑编号。
GPU_DEVICES=0,1,2,3
# 多台服务器：每台只填本机编号，参考 docs/DEPLOYMENT.md 的分片命令。
ASR_MODEL_PATH=./models/Qwen3-ASR-1.7B
ALIGNER_MODEL_PATH=./models/Qwen3-ForcedAligner-0.6B
ASR_LANGUAGE=Chinese
ASR_BATCH_SIZE=2
ASR_CHUNK_SECONDS=25
ASR_MAX_NEW_TOKENS=512
ASR_ATTENTION=sdpa
ASR_WORD_TIMESTAMPS=true
# ASR 只加载本地目录，禁止运行时自动拉模型。
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
PYANNOTE_METRICS_ENABLED=0
TOKENIZERS_PARALLELISM=false
OMP_NUM_THREADS=4

# 任意兼容 /chat/completions 的 LLM 服务；BASE_URL 包含 /v1 或服务商要求的完整前缀。
LLM_BASE_URL=https://your-llm-provider.example/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=replace-with-your-model
LLM_CONCURRENCY=4
# 0 表示不限制每分钟请求数；此限制在单次运行内全局共享。
LLM_REQUESTS_PER_MINUTE=0
LLM_TIMEOUT_SECONDS=180
LLM_RETRIES=4
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.1
# json_object 或 none；兼容不支持 response_format 的服务时填 none。
LLM_RESPONSE_FORMAT=json_object
# 下列是字符预算而不是 token；建议服务至少支持 64K 上下文。
CORRECTION_CHARS=4500
SUMMARY_CHARS=10000
REDUCE_INPUT_CHARS=16000
# 附加请求参数（JSON），例如某些模型需要 {"enable_thinking":false}。
LLM_EXTRA_BODY={}

GLOSSARY_PATH=./glossary.txt
SPEAKER_NAMES_PATH=./speaker_names.json
MEETING_CONTEXT=CNCC 中文技术论坛。按技术报告、圆桌和问答整理，不虚构行政决议或待办。
INCLUDE_TRANSCRIPT=true
# 可选，首次使用先下载 community-1 并安装 .[speakers]。
DIARIZATION=false
DIARIZATION_MODEL_PATH=./models/speaker-diarization-community-1
DIARIZATION_NUM_SPEAKERS=0
# ffmpeg 留空则优先系统程序，其次使用随 imageio-ffmpeg 分发的程序。
FFMPEG_PATH=
